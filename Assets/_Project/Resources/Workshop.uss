:root { color: rgb(44, 48, 53); font-size: 14px; }
.header { position: absolute; top: 0; left: 0; right: 0; height: 86px; background-color: rgb(248, 245, 237); padding: 12px 24px; border-bottom-width: 3px; border-bottom-color: rgb(97, 143, 132); }
.brand { font-size: 22px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(57, 98, 87); }
.stats { font-size: 14px; margin-top: 7px; }
.panel { position: absolute; top: 102px; bottom: 92px; background-color: rgba(249, 246, 237, 0.98); padding: 18px; border-radius: 12px; }
.left { left: 18px; width: 246px; }
.right { right: 18px; width: 310px; }
.eyebrow { color: rgb(97, 122, 115); font-size: 11px; letter-spacing: 1px; margin-bottom: 8px; margin-top: 10px; -unity-font-style: bold; }
.title { font-size: 22px; -unity-font-style: bold; margin-bottom: 12px; white-space: normal; }
.subtitle { font-size: 16px; -unity-font-style: bold; margin-bottom: 6px; white-space: normal; }
.body { white-space: normal; margin-bottom: 10px; }
.muted { font-size: 12px; color: rgb(102, 108, 107); white-space: normal; margin-bottom: 10px; }
.hint { font-size: 11px; color: rgb(112, 102, 87); white-space: normal; }
.card { padding: 12px; margin-bottom: 10px; background-color: rgb(238, 234, 222); border-radius: 8px; }
Button { height: 34px; margin: 3px 0 5px 0; padding: 6px; background-color: rgb(78, 121, 110); color: white; border-width: 0; border-radius: 6px; -unity-font-style: bold; }
Button:hover { background-color: rgb(99, 144, 127); }
Button:disabled { background-color: rgb(202, 208, 198); color: rgb(103, 110, 106); }
Button.selected { background-color: rgb(202, 136, 100); }
.row { flex-direction: row; margin-bottom: 12px; }
.row > Button { flex-grow: 1; margin-right: 5px; }
.footer { position: absolute; bottom: 0; left: 0; right: 0; height: 74px; padding: 12px 22px; background-color: rgb(248, 245, 237); }
.notice { font-size: 14px; -unity-font-style: bold; margin-bottom: 6px; }
.success { background-color: rgb(214, 227, 203); padding: 8px; color: rgb(46, 93, 69); white-space: normal; -unity-font-style: bold; }
.ledger { font-size: 12px; padding: 7px 0; border-bottom-width: 1px; border-bottom-color: rgb(221, 214, 199); white-space: normal; }
.menu { position: absolute; top: 86px; bottom: 0; left: 0; right: 0; align-items: center; justify-content: center; background-color: rgba(34, 55, 53, 0.35); }
.menu-card { width: 470px; padding: 30px; background-color: rgb(248, 245, 237); border-radius: 18px; }
.hero { font-size: 36px; -unity-font-style: bold; color: rgb(57, 98, 87); margin-bottom: 14px; }
